{
  "manifest_version": 3,
  "name": "텍스트 매크로",
  "description": "단축키와 오른쪽 클릭 메뉴를 이용해서 지정 문구 붙여넣을 수 있습니다.",
  "version": "1.2.0",
  "sidebar_action": {
    "default_page": "index.html",
    "default_icon": {
      "16": "images/icon.png"
    },
    "default_title": "텍스트 매크로",
    "use_navigation_bar": false
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "downloads"
  ],
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "host_permissions": ["*://*/*"],
  "commands": {
    "macro0": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Alt+Shift+1"
      },
      "description": "macro1"
    },
    "macro1": {
      "suggested_key": {
        "default": "Ctrl+Shift+2",
        "mac": "Alt+Shift+2"
      },
      "description": "macro2"
    },
    "macro2": {
      "suggested_key": {
        "default": "Ctrl+Shift+3",
        "mac": "Alt+Shift+3"
      },
      "description": "macro3"
    },
    "macro3": {
      "suggested_key": {
        "default": "Ctrl+Shift+4",
        "mac": "Alt+Shift+4"
      },
      "description": "macro4"
    }
  }
}
